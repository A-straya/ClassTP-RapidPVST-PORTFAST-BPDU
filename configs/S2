
enable
configure terminal

hostname S2
no ip domain-lookup
service password-encryption
enable secret class

banner motd #Unauthorized access is prohibited#

line console 0
 logging synchronous
 password cisco
 login
exit

line vty 0 15
 logging synchronous
 password cisco
 login
exit

!
! VLAN CONFIGURATION
!
vlan 10
 name User
exit

vlan 99
 name Management
exit

!
! TRUNK PORTS
!
interface range fastethernet0/1, fastethernet0/3
 description Inter-switch trunk
 switchport mode trunk
 switchport trunk native vlan 99
 no shutdown
exit

!
! MANAGEMENT SVI
!
interface vlan 99
 description Management
 ip address 192.168.1.12 255.255.255.0
 no shutdown
exit

!
! SPANNING TREE
!
spanning-tree mode rapid-pvst
spanning-tree vlan 1,10,99 root primary

!
! SAVE CONFIGURATION
!
end
copy running-config startup-config
